{
  "name": "@rcommerz/logger-nextjs",
  "version": "1.0.2",
  "description": "Production-ready structured logging for Next.js/React applications with OpenTelemetry support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "logger",
    "logging",
    "nextjs",
    "react",
    "frontend",
    "browser",
    "structured-logging",
    "opentelemetry",
    "observability",
    "monitoring",
    "typescript",
    "client-side",
    "tracing"
  ],
  "author": "RCOMMERZ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rcommerz/logger-nextjs.git"
  },
  "homepage": "https://github.com/rcommerz/logger-nextjs#readme",
  "bugs": {
    "url": "https://github.com/rcommerz/logger-nextjs/issues"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@opentelemetry/api": "^1.8.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.1.2",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
